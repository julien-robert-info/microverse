{
  "type": "object",
  "additionalProperties": false,
  "required": ["rubric", "scores", "defects"],
  "properties": {
    "rubric": { "const": "r1" },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fidelity", "correctness", "tests", "clarity", "scope"],
      "properties": {
        "fidelity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "correctness": { "type": "integer", "minimum": 1, "maximum": 5 },
        "tests": { "type": "integer", "minimum": 1, "maximum": 5 },
        "clarity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "scope": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "defects": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "severity", "summary"],
        "properties": {
          "criterion": { "enum": ["fidelity", "correctness", "tests", "clarity", "scope"] },
          "severity": { "enum": ["major", "minor"] },
          "summary": { "type": "string", "maxLength": 300 }
        }
      }
    }
  }
}
