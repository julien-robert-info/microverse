#!/usr/bin/env node
// Token usage of a project from the Claude Code transcripts, by model and token
// type, priced at API rates (an equivalent, not the subscription's bill).
//
// orch-usage [--since <ISO date>] [--session <id>] [--project <dir>] [--context | --agents]
//
// --agents lists each agent run (type, description, model) with its cost, to
// compare a mission's tokens with the weekly counter.
//
// --context prints the context size of the session (default: the most recent
// one), i.e. input + cache read + cache write of its last request.
"use strict";

const { existsSync, readdirSync, readFileSync, statSync } = require("node:fs");
const { homedir } = require("node:os");
const { join } = require("node:path");
const { fail, parseArgs, lastContext } = require("../scripts/orch-lib.js");

// Same parsing as scripts/context-guard.js.
const windowOption = process.env.CLAUDE_PLUGIN_OPTION_COMPACT_WINDOW;
const windowValue = /^\s*\d+\s*$/.test(windowOption ?? "") ? parseInt(windowOption, 10) : NaN;
const CONTEXT_LIMIT = windowValue >= 100e3 && windowValue <= 1e6 ? windowValue : 150e3;
// $/MTok: input, 5m cache write, 1h cache write, cache read, output.
const PRICES = {
  "claude-opus-5-5": [4, 5, 8, 0.2, 20],
  "claude-sonnet-5-5": [2, 2.5, 4, 0.1, 10],
  "claude-sonnet-5": [2, 2.5, 4, 0.2, 10],
};
// Haiku 5.5 is priced by request size: above 100K tokens of context, x5.
const HAIKU = { small: [0.1, 0.125, 0.2, 0.01, 0.5], large: [0.5, 0.625, 1, 0.05, 2.5], limit: 100e3 };

const opts = parseArgs(process.argv.slice(2));
const projectDir = typeof opts.project === "string" ? opts.project : process.cwd();

// Claude Code names a project's folder after its path, every character other
// than a letter or digit replaced by "-". The drive letter's case varies.
const root = join(homedir(), ".claude", "projects");
const slug = projectDir.replace(/[^A-Za-z0-9]/g, "-").toLowerCase();
const folder = existsSync(root) && readdirSync(root).find((n) => n.toLowerCase() === slug);
if (!folder) fail(`no conversation for ${projectDir} in ${root}`);
const dir = join(root, folder);

const sessions = readdirSync(dir)
  .filter((n) => n.endsWith(".jsonl"))
  .map((n) => ({ id: n.slice(0, -6), path: join(dir, n), mtime: statSync(join(dir, n)).mtimeMs }))
  .sort((a, b) => b.mtime - a.mtime);
if (typeof opts.session === "string" && !sessions.some((s) => s.id === opts.session)) fail(`session ${opts.session} not found`);

// Streamed replies repeat the same message id + request id on several lines
// with partial counts: keep the maximum of each counter.
function readRequests(file, kind, since, requests, agent = null) {
  for (const line of readFileSync(file, "utf8").split("\n")) {
    if (!line.includes('"usage"')) continue;
    let o;
    try {
      o = JSON.parse(line);
    } catch {
      continue;
    }
    const m = o.message;
    if (!m?.usage || !m.model?.startsWith("claude")) continue;
    if (since && new Date(o.timestamp) < since) continue;
    const v = counters(m.usage);
    // Per-step usage when an advisor may have run: "message" steps are the
    // executor (their sum is the top-level usage), "advisor_message" steps are
    // billed to the advisor's own model. Kept by index so that a streamed
    // repeat takes the maximum of each counter step by step.
    const iters = (m.usage.iterations ?? []).map((it) => ({ advisor: it.type === "advisor_message", model: it.model ?? null, v: counters(it) }));
    const id = `${m.id}:${o.requestId ?? ""}`;
    const prev = requests.get(id);
    if (prev) {
      for (let i = 0; i < v.length; i++) v[i] = Math.max(v[i], prev.v[i]);
      for (let j = 0; j < Math.max(iters.length, prev.iters.length); j++) {
        const a = iters[j], b = prev.iters[j];
        if (!a) iters[j] = b;
        else if (b) a.v = a.v.map((x, i) => Math.max(x, b.v[i]));
      }
    }
    requests.set(id, { kind, agent, model: m.model, ts: o.timestamp, v, iters });
  }
}

// [input, 5m write, 1h write, read, output] of a usage object.
function counters(u) {
  const cc = u.cache_creation ?? {};
  let w5 = cc.ephemeral_5m_input_tokens ?? 0;
  const w1 = cc.ephemeral_1h_input_tokens ?? 0;
  if (!u.cache_creation && u.cache_creation_input_tokens) w5 = u.cache_creation_input_tokens;
  return [u.input_tokens ?? 0, w5, w1, u.cache_read_input_tokens ?? 0, u.output_tokens ?? 0];
}

// Cost vector of the executor part of a request, or null without a price. The
// Haiku tier depends on each call's size, so its steps are priced one by one.
function executorCost(r) {
  const steps = r.iters.filter((it) => !it.advisor);
  if (!r.model.startsWith("claude-haiku-5-5") || !steps.length) return priceOf(r.model, r.v);
  const parts = steps.map((it) => priceOf(r.model, it.v));
  return parts.reduce((a, c) => a.map((x, i) => x + c[i]), [0, 0, 0, 0, 0]);
}

const advisorSteps = (r) => r.iters.filter((it) => it.advisor && it.model);

function priceOf(model, v) {
  let p = PRICES[model];
  if (!p && model.startsWith("claude-haiku-5-5")) p = v[0] + v[1] + v[2] + v[3] > HAIKU.limit ? HAIKU.large : HAIKU.small;
  return p ? v.map((x, i) => (x / 1e6) * p[i]) : null;
}

// The transcript's sibling .meta.json names the agent type and its task.
function agentInfo(file) {
  const id = file.replace(/^.*agent-/, "").replace(/.jsonl$/, "");
  try {
    const m = JSON.parse(readFileSync(file.replace(/.jsonl$/, ".meta.json"), "utf8"));
    return { id, type: m.agentType ?? "?", description: m.description ?? "" };
  } catch {
    return { id, type: "?", description: "" };
  }
}

const k = (n) => `${Math.round(n / 1e3)}K`;

if (opts.context) {
  const s = sessions.find((x) => x.id === opts.session) ?? sessions[0];
  if (!s) fail("no conversation");
  const last = lastContext(readFileSync(s.path, "utf8"));
  if (!last) fail(`no request in session ${s.id}`);
  const ctx = last.tokens;
  const verdict = ctx >= CONTEXT_LIMIT ? "over the threshold: auto-compaction should have run (autoCompactWindow), else ask the user for /compact" : "under the threshold";
  console.log(`Session ${s.id} (${last.model}): context ${k(ctx)} tokens, threshold ${k(CONTEXT_LIMIT)}; ${verdict}`);
  process.exit(0);
}

const since = typeof opts.since === "string" ? new Date(opts.since) : new Date(Date.now() - 7 * 24 * 3600e3);
if (Number.isNaN(since.getTime())) fail(`invalid date: ${opts.since}`);
const requests = new Map();
for (const s of sessions) {
  if (typeof opts.session === "string" && s.id !== opts.session) continue;
  readRequests(s.path, "conversation", since, requests);
  const sub = join(dir, s.id, "subagents");
  if (!existsSync(sub)) continue;
  for (const n of readdirSync(sub).filter((x) => x.endsWith(".jsonl"))) readRequests(join(sub, n), "agent", since, requests, agentInfo(join(sub, n)));
}

if (opts.agents) {
  const runs = new Map();
  for (const r of requests.values()) {
    if (r.kind !== "agent") continue;
    const run = runs.get(r.agent.id) ?? { agent: r.agent, model: r.model, n: 0, cost: 0, priced: true, ts: r.ts };
    const c = executorCost(r);
    run.n++;
    if (c) run.cost += c.reduce((a, x) => a + x, 0);
    else run.priced = false;
    // The advisor's cost belongs to the run that consulted it.
    for (const it of advisorSteps(r)) {
      const ac = priceOf(it.model, it.v);
      if (ac) run.cost += ac.reduce((a, x) => a + x, 0);
      else run.priced = false;
    }
    if (r.ts < run.ts) run.ts = r.ts;
    runs.set(r.agent.id, run);
  }
  console.log(`Agents since ${since.toISOString().slice(0, 16)}Z (API-equivalent $)`);
  console.log("started	type	model	requests	$	description");
  for (const r of [...runs.values()].sort((a, b) => (a.ts < b.ts ? -1 : 1)))
    console.log(`${r.ts.slice(0, 16)}	${r.agent.type}	${r.model}	${r.n}	${r.priced ? r.cost.toFixed(2) : "?"}	${r.agent.description}`);
  process.exit(0);
}

const rows = new Map();
for (const r of requests.values()) {
  add(`${r.kind}\t${r.model}`, r.v, executorCost(r));
  for (const it of advisorSteps(r)) add(`${r.kind}\t${it.model} (advisor)`, it.v, priceOf(it.model, it.v));
}

function add(key, v, c) {
  const row = rows.get(key) ?? { n: 0, v: [0, 0, 0, 0, 0], cost: [0, 0, 0, 0, 0], priced: true };
  row.n++;
  row.v = row.v.map((x, i) => x + v[i]);
  if (c) row.cost = row.cost.map((x, i) => x + c[i]);
  else row.priced = false;
  rows.set(key, row);
}

const M = (x) => (x / 1e6).toFixed(2);
const $ = (x) => x.toFixed(2);
console.log(`Since ${since.toISOString().slice(0, 16)}Z${typeof opts.session === "string" ? `, session ${opts.session}` : ""} (tokens in millions, costs in API-equivalent $)`);
console.log("type	model	requests	input	write5m	write1h	read	output	$total");
let total = 0;
for (const [key, row] of [...rows].sort()) {
  const cost = row.cost.reduce((s, x) => s + x, 0);
  total += cost;
  console.log(`${key}\t${row.n}\t${row.v.map(M).join("\t")}\t${row.priced ? $(cost) : "?"}`);
}
console.log(`total\t\t\t\t\t\t\t\t${$(total)}${[...rows.values()].some((r) => !r.priced) ? " (excluding models without a price)" : ""}`);
