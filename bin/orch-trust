#!/usr/bin/env node
// Approval of the project's orchestration profile. `profile.json` holds shell
// commands that agent-check and the agents run, so a cloned repository gets
// none of them run until the user has read the profile and approved it here.
//
// orch-trust                 state, fingerprint and commands of the profile; writes nothing
// orch-trust <sha256>        approves the profile if its fingerprint is that one
// orch-trust --status        exit 0 when approved or without profile, 1 otherwise
// orch-trust --commands setup|checks   the approved profile's commands, one per line
//
// Every mode takes --project <dir>: the project is resolved from <dir> instead
// of the current directory.
//
// The profile is the one of the main worktree, whatever the current directory.
// Only the user approves, with the line this script prints (`node "<this
// script>" <sha256> --project "<root>"`, prefixed with `! ` at the Claude Code
// CLI prompt); an agent never does, and it must not be put in a permission
// allow list.
"use strict";

const { existsSync, statSync } = require("node:fs");
const { resolve } = require("node:path");
const { approvalAsk, approveProfile, describeCommands, fail, git, mainRoot, parseArgs, profileTrust, sanitize } = require("../scripts/orch-lib.js");

const opts = parseArgs(process.argv.slice(2), { flags: ["status"] });
let project = process.cwd();
if (opts.project !== undefined) {
  if (typeof opts.project !== "string") fail("usage: orch-trust --project <dir>");
  project = resolve(opts.project);
  if (!existsSync(project) || !statSync(project).isDirectory()) fail(`--project: no such directory: ${project}`);
  if (git(["rev-parse", "--git-dir"], project).code !== 0) fail(`--project: not in a git repository: ${project}`);
}
const root = mainRoot(project);
const trust = profileTrust(root);

// The commands an agent may run, parsed from the approved profile of the main
// worktree: an agent reading the profile file of its own branch could run
// something else than what the user approved.
if (opts.commands !== undefined) {
  if (opts.commands !== "setup" && opts.commands !== "checks") fail("usage: orch-trust --commands setup|checks");
  if (trust.state === "none") return;
  if (trust.state !== "approved") {
    console.error(`profile ${trust.state === "invalid" ? `invalid (${trust.reason})` : "not approved"}: run no command of it`);
    process.exitCode = 1;
    return;
  }
  const list = trust[opts.commands];
  // What would print differently once sanitized (line break, control, tag,
  // zero-width or bidi character) is not what the user read: run none.
  if (list.some((c) => sanitize(c) !== c || /[\p{Cc}\p{Zl}\p{Zp}]/u.test(c))) fail("a command holds a hidden or control character: read it with orch-trust, run none");
  if (list.length) console.log(list.join("\n"));
  return;
}

if (opts.status) {
  console.log(trust.state);
  process.exitCode = trust.state === "none" || trust.state === "approved" ? 0 : 1;
  return;
}

const given = opts._[0];
if (given === undefined) {
  console.log(`profile: ${trust.state}${trust.reason ? ` (${trust.reason})` : ""}`);
  if (trust.hash) {
    console.log(`file: ${trust.file}`);
    console.log(`fingerprint: ${trust.hash}`);
    console.log(`commands (${trust.commands.length}):\n${describeCommands(trust.commands, { full: true }).join("\n")}`);
    if (trust.state === "unapproved" && root) console.log(`\n${approvalAsk(trust.hash, root)}`);
  }
  return;
}

if (trust.state === "none") fail("no profile to approve");
if (trust.state === "invalid") fail(`the profile is invalid and cannot be approved: ${trust.reason}`);
if (!trust.hash) fail(`nothing to approve: ${trust.reason}`);
if (given !== trust.hash) fail("profile changed or fingerprint wrong: rerun without argument and read it again");
approveProfile(root, trust.hash);
console.log(`approved ${trust.hash}`);
