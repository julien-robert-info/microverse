#!/usr/bin/env node
// Reads the quota counters and turns them into a pacing advice for launching
// agents. Two sources are merged: the readings recorded by the VS Code
// extension "Claude Code Usage" (growthjack), and those written by the
// microverse status line of terminal sessions (scripts/statusline.js). Per
// counter, the current window is the latest one not yet reset, and its value the
// highest reading of that window. The status line also keeps a 15-day history
// of the rising readings (statusline-history/): it gives the usage at the start
// of the weekday period. The calibration uses one source, never both: the
// extension while it has a reading under 48 hours old, else that history.
//
// orch-quota [--target 98] [--reserve 30] [--five-hour 90] [--running 0]
//             [--agent-cost 15] [--file <path>] [--mode auto|off] [--no-write] [--json]
//
// --mode (else CLAUDE_PLUGIN_OPTION_QUOTA_MODE, else auto) is the quota_mode
// setting. off, a `orch-reading --none` marker newer than every reading, or no
// source at all (no extension file at the default location, no status line
// reading, no history), print "Quota: off (<reason>)" and exit 0: no counters, no pacing.
// JSON then carries mode "off", reason, advice and an `error` key (older readers
// of this output take it as "no counters"); otherwise it carries mode "metered".
//
// --json prints one JSON object on one line instead of the text, with the same
// figures (dates in milliseconds, percentages as integers): counters, limits,
// period, pace, running agents, agent cost, advice, warnings, the readings of
// the current weekly window and, with --calibrate, the calibration. A failure is
// { "v": 1, "error" } with exit code 1. It writes exactly what the text does.
//
// --no-write leaves everything as found: the installed status line script is
// not refreshed, expired readings are not deleted and a calibration is not
// saved (a stale one is recomputed in memory, with the same result).
//
// --running is the number of agents working now; with --agent-cost (points of
// the 5h counter one agent may use) it bounds new launches by the room left
// under the 5h limit. Without --running, the agents of all projects of the
// account are counted from their transcripts' modification times. Without
// --agent-cost, the cost is learned from past runs (see --calibrate).
//
// orch-quota --calibrate recomputes the calibration (points of each counter per
// API-equivalent dollar, median cost of each agent role) and prints it. It is
// otherwise recomputed when older than 6 hours.
//
// The weekly window is split in two periods: the weekend (window start to
// Sunday 24:00 local time) may use up to target - reserve %, the weekdays
// share the rest up to the target. The window is assumed to start at the end
// of a week.
"use strict";

const { existsSync, readFileSync } = require("node:fs");
const lib = require("../scripts/orch-lib.js");
const statusline = require("../scripts/statusline.js");
const { parseArgs } = lib;

const HOUR = 3600e3;
const DAY = 24 * HOUR;

const opts = parseArgs(process.argv.slice(2), { flags: ["calibrate", "no-write", "json"] });
const json = Boolean(opts.json);
const write = !opts["no-write"];
// An empty value is unset: Number("") is 0, which would stop every launch.
const num = (v, d) => (v === undefined || v === true || v === "" || Number.isNaN(Number(v)) ? d : Number(v));
const target = num(opts.target, 98);
const reserve = num(opts.reserve, 30);
const fiveLimit = num(opts["five-hour"], 90);

// An unset plugin option can reach us as an empty string or as the literal
// `${user_config.quota_file}`: both mean "use the default location".
const file = lib.setOption(opts.file) ? opts.file : lib.defaultQuotaFile();
const now = Date.now();

// The result is built as one object, then printed as text or as JSON. The
// notes below are the warnings, in the order the text prints them.
const emit = (o) => console.log(JSON.stringify({ v: 1, ...o }));
const failed = (lines) => {
  if (json) emit({ error: lib.sanitize(lines.join(" ")) });
  else for (const l of lines) console.log(l);
  process.exitCode = 1;
};
const startNotes = [];
const calNotes = [];
const lateNotes = [];

// Keeps the installed copy of the status line script current; never fatal.
if (write) {
  try {
    statusline.refreshInstalled();
  } catch (e) {
    startNotes.push(`Status line script not refreshed: ${e.message}`);
  }
}

// Extension file: absent or unreadable is allowed when the status line has readings.
let observations = [];
let fileProblem = null;
if (!existsSync(file)) fileProblem = `Counters not found: ${file} is missing`;
else {
  try {
    observations = JSON.parse(readFileSync(file, "utf8")).observations ?? [];
  } catch (e) {
    fileProblem = `Counters unreadable (${file}): ${e.message}`;
  }
}
// Read without pruning: an old reading proves a subscription exists, so the
// mode must see it. The pruning happens below, once a current reading is found.
const statuslineObs = lib.statuslineObservations(statusline.readReadings({ now }));
const historyObs = lib.risingOnly(statusline.readHistory({ now }));
// The mode alone sees the history of any age: an old file proves a subscription.
const modeHistoryObs = lib.risingOnly(statusline.readHistory({ now, days: Infinity }));
// Deletes what the status line left beyond its retention; not with --no-write.
const prune = () => {
  if (!write) return;
  statusline.readReadings({ now, prune: true });
  statusline.readHistory({ now, prune: true });
};

// quota_mode: off, or no source at all, means no pacing and no counters asked.
const modeOption = lib.setOption(opts.mode) ? opts.mode : process.env.CLAUDE_PLUGIN_OPTION_QUOTA_MODE;
const decided = lib.quotaMode({
  option: modeOption,
  marker: lib.readQuotaMarker(),
  readings: { extensionObs: observations, statuslineObs, historyObs: modeHistoryObs },
  now,
});
if (decided.warning) startNotes.push(decided.warning);
const REASON = {
  option: "quota_mode=off",
  get_usage: "no quota windows, from get_usage",
  user: "no quota windows, said by the user",
  "no-source": "no counter source",
};
// Not "no source", the counters may exist: a file that is unreadable or holds no
// Claude observation, and an explicit path (--file) that is absent.
const claudeObs = observations.filter((o) => (o.provider ?? "claude") === "claude");
const unreadable = existsSync(file) ? Boolean(fileProblem) || !claudeObs.length : lib.setOption(opts.file);
if (decided.mode === "off" && !(decided.reason === "no-source" && unreadable)) {
  if (json) {
    const text = REASON[decided.reason];
    emit({
      mode: "off",
      reason: text,
      // Kept for consumers that read counters unless this key is set.
      error: `Quota off (${text}): no pacing.`,
      advice: { level: "off", text: "no quota: no pacing", more: 0 },
      ...(startNotes.length && { warnings: startNotes.map((t) => lib.sanitize(t)) }),
    });
  } else {
    for (const l of startNotes) console.log(l);
    console.log(`Quota: off (${REASON[decided.reason]})`);
    console.log("Advice: no quota: no pacing");
  }
  return;
}

if (!claudeObs.length && !statuslineObs.length && !modeHistoryObs.length) {
  // A refresh failure is still reported in text mode, as before.
  if (!json) for (const l of startNotes) console.log(l);
  failed([
    fileProblem ? `${fileProblem}, and no status line reading exists.` : `Counters not found: ${file} has no reading, and no status line reading exists.`,
    "The extension is read in VS Code; in a terminal session the status line is set up by /microverse:init.",
    "Ask the user for both counters (5h and week, in %).",
  ]);
  return;
}

const { extensionObs, week, f, w } = lib.mergeReadings({ extensionObs: observations, statuslineObs, historyObs, now });
if (!w) {
  if (!json) for (const l of startNotes) console.log(l);
  failed(["No current weekly reading: ask the user for the counters, or run orch-reading --none if the plan has no limits."]);
  return;
}

prune();

// Agents running and cost of one agent: given, else detected / learned.
const files = lib.walkTranscripts();
let runningLine;
// Other projects' agents are unknown when the count is given.
let runningOthers = null;
let running = num(opts.running, null);
if (running !== null) runningLine = `Running: ${running} agent${running === 1 ? "" : "s"} (given)`;
else {
  const r = lib.countRunning(files, { now, currentSlug: lib.projectSlug(process.cwd()) });
  running = r.total;
  runningOthers = r.others;
  runningLine = `Running: ${r.total} agent${r.total === 1 ? "" : "s"} (${r.others} in other projects)`;
}

// Calibration source: interleaving two sources one point apart would create
// intervals that do not exist, so one is chosen. The extension is the finer one
// while it is alive.
const source = extensionObs.some((o) => o.observedAt >= now - 48 * HOUR) || !historyObs.length ? "extension" : "statusline";

let cal = lib.loadCalibration();
let calNote = null;
if (opts.calibrate || lib.calibrationStale(cal, now)) {
  try {
    cal = lib.computeCalibration({ files, observations: source === "extension" ? observations : historyObs, now, previous: cal, source });
  } catch (e) {
    calNote = `Calibration unavailable: ${e.message}`;
  }
  // A computed calibration is used even when it cannot be stored; the next run
  // then recomputes it. Without writing it stays in memory.
  if (!calNote && write) {
    try {
      lib.saveCalibration(cal);
    } catch (e) {
      calNote = `Calibration not saved: ${e.message}`;
    }
  }
}
if (calNote) calNotes.push(calNote);
if (cal?.change) calNotes.push(cal.change);
let agentCost = num(opts["agent-cost"], null);
let costLine;
let learnedRuns = null;
if (agentCost !== null) costLine = `Agent cost: ${agentCost} points of 5h (given)`;
else {
  const learned = lib.learnedAgentCost(cal);
  agentCost = learned?.points ?? lib.FIVE_HOUR_COST;
  learnedRuns = learned?.runs ?? null;
  costLine = learned
    ? `Agent cost: ~${agentCost} points of 5h (learned from ${learned.runs} runs)`
    : `Agent cost: ${agentCost} points of 5h (default)`;
}

const { used5, used7, period, expected, delta, reset5 } = lib.quotaState({ week, f, w, now, target, reserve });
const fmt = lib.fmtDate;
const hours = (ms) => `${Math.max(0, ms / HOUR).toFixed(ms < 10 * HOUR ? 1 : 0)} h`;

const advice = lib.paceDecision({ used7, used5, delta, target, period: period.target, fiveLimit, reset5, running, agentCost });

const age = now - Math.max(w.observedAt, f?.observedAt ?? 0);
const src = (r) => `${r.source === "statusline" ? "status line" : "extension"}, ${lib.fmtAge(now - r.observedAt)} ago`;
if (age > 2 * HOUR)
  lateNotes.push(`Warning: last reading ${hours(age)} ago (the extension updates while VS Code runs, the status line at each answer of a terminal session).`);
const stale5 = lib.staleFiveHourWarning(f, now);
if (stale5) lateNotes.push(stale5);
const left = Math.max(0, period.target - used7);

if (json) {
  const counter = (r, used) => (r ? { used, resetsAt: r.resetAt, observedAt: r.observedAt, source: r.source } : null);
  // The readings of the current weekly window (a reset an hour or more apart
  // is another window), all sources, as the points where the counter rose.
  const history = lib
    .risingOnly(week.filter((o) => Number.isFinite(o.resetAt) && Math.abs(o.resetAt - w.resetAt) < HOUR))
    .sort((a, b) => a.observedAt - b.observedAt)
    .slice(-500)
    .map((o) => ({ at: o.observedAt, used: Math.round(o.usedFraction * 100) }));
  const out = {
    mode: "metered",
    project: lib.mainRoot(process.cwd()) ?? process.cwd(),
    counters: { five: counter(f, used5), week: counter(w, used7) },
    limits: { target, reserve, fiveHour: fiveLimit },
    period: { name: period.name, start: period.start, end: period.end, target: period.target },
    pace: { expected: Math.round(expected), actual: used7, delta: Math.round(delta), left },
    running: { total: running, others: runningOthers },
    agentCost: { points: agentCost, runs: learnedRuns },
    advice,
    warnings: [...startNotes, ...calNotes, ...lateNotes].map((t) => lib.sanitize(t)),
    history,
  };
  if (opts.calibrate) out.calibration = cal ?? null;
  emit(out);
  return;
}

for (const l of startNotes) console.log(l);
if (opts.calibrate && cal) {
  const r = (x, n) => (x === null ? `none (${n} intervals, 5 needed)` : `${lib.fmtRatio(x)} points/$ (${n} intervals)`);
  const from = Math.max(cal.at - 14 * DAY, cal.since ?? 0);
  console.log(`Calibration of ${new Date(cal.at).toISOString().slice(0, 16)}Z from ${cal.source === "statusline" ? "the status line history" : "the extension"}, intervals since ${new Date(from).toISOString().slice(0, 16)}Z`);
  console.log(`5h: ${r(cal.ratio5, cal.n5)}`);
  console.log(`Week: ${r(cal.ratio7, cal.n7)}`);
  for (const [role, v] of Object.entries(cal.roles)) console.log(`${role}: ${v.median === null ? `no median (${v.n} runs, 5 needed)` : `median $${v.median.toFixed(2)} (${v.n} runs)`}`);
}
for (const l of calNotes) console.log(l);
console.log(`Counters: 5h ${used5} %${f ? ` (resets ${fmt(f.resetAt)}; ${src(f)})` : ""}, week ${used7} % (resets ${fmt(w.resetAt)}; ${src(w)})`);
for (const l of lateNotes) console.log(l);
console.log(`Period: ${period.name} until ${fmt(period.end)}, ${hours(period.end - now)} left, target ${period.target} %`);
console.log(`Pace: expected ${Math.round(expected)} % by now, actual ${used7} % (${delta >= 0 ? "+" : ""}${Math.round(delta)} points); ${left} points left for the period`);
console.log(runningLine);
console.log(costLine);
console.log(`Advice: ${advice.text}`);
