#!/usr/bin/env node
// Reads the quota counters recorded by the VS Code extension "Claude Code
// Usage" (growthjack) and turns them into a pacing advice for launching agents.
//
// orch-quota [--target 98] [--reserve 30] [--five-hour 90] [--running 0]
//             [--agent-cost 15] [--file <path>]
//
// --running is the number of agents working now; with --agent-cost (points of
// the 5h counter one agent may use) it bounds new launches by the room left
// under the 5h limit. Without --running, the agents of all projects of the
// account are counted from their transcripts' modification times. Without
// --agent-cost, the cost is learned from past runs (see --calibrate).
//
// orch-quota --calibrate recomputes the calibration (points of each counter per
// API-equivalent dollar, median cost of each agent role) and prints it. It is
// otherwise recomputed when older than 6 hours.
//
// The weekly window is split in two periods: the weekend (window start to
// Sunday 24:00 local time) may use up to target - reserve %, the weekdays
// share the rest up to the target. The window is assumed to start at the end
// of a week.
"use strict";

const { existsSync, readFileSync } = require("node:fs");
const { homedir } = require("node:os");
const { join } = require("node:path");
const lib = require("../scripts/orch-lib.js");
const { paceAdvice, parseArgs } = lib;

const HOUR = 3600e3;
const DAY = 24 * HOUR;

const opts = parseArgs(process.argv.slice(2), { flags: ["calibrate"] });
const num = (v, d) => (v === undefined || v === true || Number.isNaN(Number(v)) ? d : Number(v));
const target = num(opts.target, 98);
const reserve = num(opts.reserve, 30);
const fiveLimit = num(opts["five-hour"], 90);

function defaultFile() {
  const rel = ["Code", "User", "globalStorage", "growthjack.claude-code-usage", "quota-observations-v2.json"];
  if (process.platform === "win32") return join(process.env.APPDATA ?? join(homedir(), "AppData", "Roaming"), ...rel);
  if (process.platform === "darwin") return join(homedir(), "Library", "Application Support", ...rel);
  return join(homedir(), ".config", ...rel);
}

// An unset plugin option can reach us as an empty string or as the literal
// `${user_config.quota_file}`: both mean "use the default location".
const given = typeof opts.file === "string" && opts.file && !opts.file.includes("${") ? opts.file : null;
const file = given ?? defaultFile();
if (!existsSync(file)) {
  console.log(`Counters not found: ${file} is missing.`);
  console.log("Ask the user for both counters (5h and week, in %).");
  process.exit(1);
}

let observations;
try {
  observations = JSON.parse(readFileSync(file, "utf8")).observations ?? [];
} catch (e) {
  console.log(`Counters unreadable (${file}): ${e.message}`);
  process.exit(1);
}

const byType = (type) =>
  observations
    .filter((o) => o.periodType === type && (o.provider ?? "claude") === "claude")
    .sort((a, b) => a.observedAt - b.observedAt);
const five = byType("five-hour");
const week = byType("seven-day");
if (!week.length) {
  console.log("No weekly reading in the file: ask the user for the counters.");
  process.exit(1);
}

const now = Date.now();

// Agents running and cost of one agent: given, else detected / learned.
const files = lib.walkTranscripts();
let runningLine;
let running = num(opts.running, null);
if (running !== null) runningLine = `Running: ${running} agent${running === 1 ? "" : "s"} (given)`;
else {
  const r = lib.countRunning(files, { now, currentSlug: lib.projectSlug(process.cwd()) });
  running = r.total;
  runningLine = `Running: ${r.total} agent${r.total === 1 ? "" : "s"} (${r.others} in other projects)`;
}

let cal = lib.loadCalibration();
let calNote = null;
if (opts.calibrate || lib.calibrationStale(cal, now)) {
  try {
    cal = lib.computeCalibration({ files, observations, now, previous: cal });
  } catch (e) {
    calNote = `Calibration unavailable: ${e.message}`;
  }
  // A computed calibration is used even when it cannot be stored; the next run
  // then recomputes it.
  if (!calNote) {
    try {
      lib.saveCalibration(cal);
    } catch (e) {
      calNote = `Calibration not saved: ${e.message}`;
    }
  }
}
let agentCost = num(opts["agent-cost"], null);
let costLine;
if (agentCost !== null) costLine = `Agent cost: ${agentCost} points of 5h (given)`;
else {
  const learned = lib.learnedAgentCost(cal);
  agentCost = learned?.points ?? lib.FIVE_HOUR_COST;
  costLine = learned
    ? `Agent cost: ~${agentCost} points of 5h (learned from ${learned.runs} runs)`
    : `Agent cost: ${agentCost} points of 5h (default)`;
}

if (opts.calibrate && cal) {
  const r = (x, n) => (x === null ? `none (${n} intervals, 5 needed)` : `${lib.fmtRatio(x)} points/$ (${n} intervals)`);
  console.log(`Calibration of ${new Date(cal.at).toISOString().slice(0, 16)}Z over 14 days`);
  console.log(`5h: ${r(cal.ratio5, cal.n5)}`);
  console.log(`Week: ${r(cal.ratio7, cal.n7)}`);
  for (const [role, v] of Object.entries(cal.roles)) console.log(`${role}: ${v.median === null ? `no median (${v.n} runs, 5 needed)` : `median $${v.median.toFixed(2)} (${v.n} runs)`}`);
}
if (calNote) console.log(calNote);
if (cal?.change) console.log(cal.change);

const w = week.at(-1);
const f = five.at(-1);
const used7 = Math.round(w.usedFraction * 100);
// A five-hour reading whose reset has passed is stale: the counter is back to 0.
const used5 = f && f.resetAt > now ? Math.round(f.usedFraction * 100) : 0;

const fmt = (ms) =>
  new Date(ms).toLocaleString("en-GB", { weekday: "short", day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" });
const hours = (ms) => `${Math.max(0, ms / HOUR).toFixed(ms < 10 * HOUR ? 1 : 0)} h`;

const windowStart = w.resetAt - 7 * DAY;
const monday = new Date(windowStart);
monday.setHours(0, 0, 0, 0);
do monday.setDate(monday.getDate() + 1);
while (monday.getDay() !== 1);
const weekendEnd = monday.getTime();
const hasWeekend = weekendEnd - windowStart <= 3 * DAY;

let period;
if (hasWeekend && now < weekendEnd) period = { name: "weekend", start: windowStart, end: weekendEnd, target: target - reserve };
else if (hasWeekend) period = { name: "weekdays", start: weekendEnd, end: w.resetAt, target };
else period = { name: "whole window", start: windowStart, end: w.resetAt, target };

// Usage when the period began: the last reading of this window taken before
// it, else 0 at the window start, else the first reading inside the period.
const sameWindow = week.filter((o) => Math.abs(o.resetAt - w.resetAt) < HOUR);
const before = sameWindow.filter((o) => o.observedAt <= period.start).at(-1);
let startUsed;
if (before) startUsed = before.usedFraction * 100;
else if (period.start === windowStart) startUsed = 0;
else startUsed = (sameWindow.find((o) => o.observedAt >= period.start) ?? w).usedFraction * 100;

const elapsed = Math.min(1, Math.max(0, (now - period.start) / (period.end - period.start)));
const expected = startUsed + (period.target - startUsed) * elapsed;
const delta = used7 - expected;
const reset5 = f ? ` until the 5h counter resets (${fmt(f.resetAt)})` : "";

const advice = paceAdvice({ used7, used5, delta, target, period: period.target, fiveLimit, reset5, running, agentCost });

const age = now - Math.max(w.observedAt, f?.observedAt ?? 0);
console.log(
  `Counters: 5h ${used5} %${f && f.resetAt > now ? ` (resets ${fmt(f.resetAt)})` : ""}, week ${used7} % (resets ${fmt(w.resetAt)})`,
);
if (age > 2 * HOUR) console.log(`Warning: last reading ${hours(age)} ago (the extension updates the file while VS Code runs).`);
console.log(`Period: ${period.name} until ${fmt(period.end)}, ${hours(period.end - now)} left, target ${period.target} %`);
console.log(
  `Pace: expected ${Math.round(expected)} % by now, actual ${used7} % (${delta >= 0 ? "+" : ""}${Math.round(delta)} points); ${Math.max(0, period.target - used7)} points left for the period`,
);
console.log(runningLine);
console.log(costLine);
console.log(`Advice: ${advice}`);
