#!/usr/bin/env node
// Mechanical checks on an agent's branch before reading its diff: commits
// exist, worktree is clean, the profile's checks pass, no suspicious pattern in
// the added lines, and the branch merges cleanly into the base. Prints OK or the
// tail of each failure only.
//
// agent-check <branch> [--base main] [--no-checks] [--merged] [--json]
//
// --json prints one JSON object instead of the text, with the same verdict and
// exit code: { v, branch, base, verdict, commits, checks[{ name, state, detail,
// lines }] }, or { v, branch, error } when nothing could be checked.
//
// --merged runs the checks on the result of merging the base into the branch
// (done in the branch's worktree, then undone) instead of on the branch alone.
// A second run on the same worktree is refused while the first is alive.
//
// The profile is the main worktree's, and its commands run only after the user
// approved it (orch-trust); otherwise nothing runs and the exit code is 2.
// A diff touching .claude/orchestration/ fails the patterns.
//
// Exit code: 0 when everything passes, 1 otherwise, 2 when the profile is not approved.
"use strict";

const { spawnSync } = require("node:child_process");
const { readFileSync, rmSync, writeFileSync } = require("node:fs");
const { join } = require("node:path");
const { approvalAsk, defaultBase, describeCommands, fail, git, mainRoot, parseArgs, profileTrust, repoRoot, sanitize, validBranch, worktreeFor } = require("../scripts/orch-lib.js");

// One choke point for everything printed: branch names, commit subjects, file
// names, check output and git errors come from the repository.
for (const m of ["log", "error"]) {
  const orig = console[m].bind(console);
  console[m] = (...a) => orig(...a.map((x) => (typeof x === "string" ? sanitize(x) : x)));
}

const TAIL = 25;
// UTF-8 text decoded as cp1252 then re-encoded: U+00E9 becomes U+00C3 U+00A9,
// U+2014 becomes U+00E2 U+20AC U+201D. Escaped so this file does not match itself.
const BUILTIN = [{ pattern: "\\u00C3[\\u0080-\\u00BF\\u2018-\\u2030]|\\u00E2\\u20AC", why: "UTF-8 double encoding" }];

const opts = parseArgs(process.argv.slice(2), { flags: ["no-checks", "merged", "json"] });
const json = opts.json === true;
const branch = opts._[0];

// Every control is a record; the text prints each one as it is added (so a
// later failure still leaves the earlier lines), the JSON prints them all at
// the end. `text` is null for a record that only exists in the JSON.
const records = [];
const indent = (lines) => lines.map((l) => `    ${l}`).join("\n");
function add(name, state, detail, lines, text) {
  records.push({ name, state, detail, lines });
  if (!json && text != null) console.log(text);
}
// JSON output: strings come from the repository, so sanitized, never cut.
function emit(obj) {
  console.log(JSON.stringify({ v: 1, ...obj }, (_k, x) => (typeof x === "string" ? sanitize(x) : x)));
}
// Ends the run on an error: JSON `{ v, branch, error }` on stdout, otherwise
// the text. Callers return right after, so stdout is flushed by a normal exit.
function stop(message, code) {
  if (json) emit({ branch, error: message });
  else if (code === 2) fail(message);
  else console.log(`FAIL ${message}`);
  process.exitCode = code;
}
function finish(verdictLine) {
  const green = ok;
  if (json) {
    emit({
      branch,
      base,
      verdict: green ? "green" : "needs-fixes",
      commits: commits.map((c) => ({ sha: c.slice(0, c.indexOf(" ")), subject: c.slice(c.indexOf(" ") + 1) })),
      checks: records,
    });
  } else if (verdictLine) console.log(green ? `\n${branch}: all green` : `\n${branch}: needs fixes`);
  process.exitCode = green ? 0 : 1;
}

if (!branch) return stop("usage: agent-check <branch> [--base main] [--no-checks] [--merged] [--json]", 2);
if (!validBranch(branch)) return stop("REFUSED: invalid branch name, nothing touched", 2);
const root = repoRoot();
const base = typeof opts.base === "string" ? opts.base : defaultBase(root);
// The profile of the main worktree, never the branch's: the branch is what is
// being reviewed. Its commands run only once the user has approved it.
const main = mainRoot(root);
const trust = profileTrust(main);
if (trust.state === "invalid") return stop(`profile invalid (${trust.reason}): agent-check ran none of its commands`, 2);
if (trust.state === "unapproved" && !trust.hash) return stop(`profile not approved (${trust.reason}): agent-check ran none of its commands`, 2);
if (trust.state === "unapproved") {
  return stop(
    `profile not approved: agent-check runs its commands and ran none.\n${describeCommands(trust.commands).join("\n")}\n` +
      `Read it (orch-trust).\n${approvalAsk(trust.hash, main)}`,
    2,
  );
}
// Only the validated lists of profileTrust are run, never the raw profile.
const profile = trust.profile ?? {};
const checkList = profile.checks ?? [];
const teardownList = trust.teardown;
let ok = true;
const tailLines = (text) => text.trimEnd().split(/\r?\n/).slice(-TAIL);
const tail = (text) => indent(tailLines(text));

const log = git(["log", "--oneline", `${base}..${branch}`], root);
if (log.code !== 0) return stop(`branch not found: ${branch}\n${log.err.trim()}`, 2);
const commits = log.out.trim().split("\n").filter(Boolean);
if (!commits.length) {
  ok = false;
  const why = `no commit on ${branch} since ${base} (did the agent work, or delegate?)`;
  add("commits", "fail", why, [], `FAIL commits: ${why}`);
  return finish(false);
}
add("commits", "ok", String(commits.length), commits, `commits (${commits.length}):\n${indent(commits)}`);

// A merge that cannot be done is checked on a throwaway tree, so nothing is
// touched. `--write-tree` needs git >= 2.38; older versions exit with another code.
let conflicted = false;
const mt = git(["merge-tree", "--write-tree", "--name-only", base, branch], root);
if (mt.code === 0) add("merge", "ok", "", [], "OK  merge");
else if (mt.code === 1) {
  ok = false;
  conflicted = true;
  const files = mt.out.split(/\r?\n/).slice(1);
  const end = files.indexOf("");
  const names = files.slice(0, end < 0 ? files.length : end).filter(Boolean);
  add("merge", "fail", `conflicts with ${base}`, names, `FAIL merge: conflicts with ${base}\n${indent(names)}`);
} else add("merge", "skip", "not checked (needs git >= 2.38)", [], "--  merge: not checked (needs git >= 2.38)");

const behind = Number(git(["rev-list", "--count", `${branch}..${base}`], root).out.trim()) || 0;
if (behind > 0 && !opts.merged) {
  const d = `${behind} commit(s) on ${base} since the branch point; checks ran on the branch alone (rerun with --merged)`;
  add("behind", "skip", d, [], `--  base: ${d}`);
}

const changed = git(["diff", "--name-only", "--no-renames", `${base}...${branch}`], root).out.trim().split("\n").filter(Boolean);
const wt = worktreeFor(root, branch);
if (!wt) add("worktree", "skip", "none for this branch, checks not run", [], "worktree: none for this branch, checks not run");
else {
  const held = lockWorktree(wt);
  if (held) return stop(held.message, held.code);
  const status = git(["status", "--porcelain"], wt).out.trimEnd();
  if (status) {
    ok = false;
    add("worktree", "fail", `uncommitted changes in ${wt}`, tailLines(status), `FAIL worktree: uncommitted changes in ${wt}\n${tail(status)}`);
  } else add("worktree", "ok", "clean", [], "OK  worktree clean");

  // --merged runs the checks on the merge result, in the agent's own worktree
  // (its dependencies are installed there). It needs a clean tree and a merge
  // that has something to do; the merge is always aborted afterwards.
  let merging = false;
  let mergeFailed = false;
  const head = git(["rev-parse", "HEAD"], wt).out.trim();
  if (opts.merged) {
    const skipped = (why) => add("merged", "skip", why, [], `--  merged: ${why}`);
    if (status) skipped("skipped (worktree not clean)");
    else if (conflicted) skipped(`skipped (conflicts with ${base})`);
    else if (behind === 0) skipped(`skipped (${base} is already merged, nothing to combine)`);
    else {
      const m = git(["merge", "--no-ff", "--no-commit", base], wt);
      merging = true;
      if (m.code !== 0) {
        ok = false;
        mergeFailed = true;
        add("merge", "fail", `conflicts with ${base}`, tailLines(m.out || m.err), `FAIL merge: conflicts with ${base}\n${tail(m.out || m.err)}`);
      } else add("merged", "ok", `checks run on the merge of ${base}`, [], `--  merged: checks run on the merge of ${base}`);
    }
  }
  // State the checks start from: the merge itself leaves staged changes.
  const baseline = merging ? git(["status", "--porcelain"], wt).out.trimEnd() : "";

  try {
    if (!mergeFailed) runChecks(wt, baseline);
  } finally {
    if (merging) {
      git(["merge", "--abort"], wt);
      const left = git(["status", "--porcelain"], wt).out.trimEnd();
      if (git(["rev-parse", "HEAD"], wt).out.trim() !== head || left) {
        ok = false;
        add("worktree", "fail", "merge not undone", tailLines(left), `FAIL worktree: merge not undone\n${tail(left)}`);
      }
    }
  }
}

// Two runs on one worktree collide: one's `merge --abort` undoes the other's
// merge mid-checks, and the build tools lock their output folder. The lock
// lives in the worktree's git dir, holds the pid, and is taken over when that
// process is gone. Returns null once taken, else the refusal { message, code }.
function lockWorktree(wt) {
  const lock = join(git(["rev-parse", "--absolute-git-dir"], wt).out.trim(), "microverse-agent-check.lock");
  for (let attempt = 0; attempt < 2; attempt++) {
    try {
      writeFileSync(lock, String(process.pid), { flag: "wx" });
      process.on("exit", () => rmSync(lock, { force: true }));
      return null;
    } catch (e) {
      if (e.code !== "EEXIST") throw e;
    }
    let pid;
    try {
      pid = Number(readFileSync(lock, "utf8").trim());
    } catch (e) {
      if (e.code === "ENOENT") continue; // released between our two calls
      throw e;
    }
    // An empty or unreadable lock is a run between creating and writing it: live.
    if (!pid || alive(pid)) {
      return { message: `another agent-check is running on ${branch} (pid ${pid || "unknown"}): wait for its result`, code: 1 };
    }
    const refused = reclaimStale(lock, pid);
    if (refused) return refused;
  }
  return { message: `cannot take the lock ${lock}`, code: 2 };
}

// Removing a stale lock and creating ours are two steps: without a guard, a
// second run that read the same stale pid deletes the first one's fresh lock
// and both proceed. Only the run holding the exclusively created guard may
// remove it, after checking it is still the stale one.
function reclaimStale(lock, stalePid) {
  const guard = `${lock}.reclaim`;
  try {
    writeFileSync(guard, String(process.pid), { flag: "wx" });
  } catch (e) {
    if (e.code !== "EEXIST") throw e;
    return { message: `another agent-check is reclaiming the lock of ${branch}: wait for its result (stuck? remove ${guard})`, code: 1 };
  }
  try {
    let current;
    try {
      current = Number(readFileSync(lock, "utf8").trim());
    } catch {
      return null;
    }
    // Alive is re-checked: the pid may have been reused since it was read.
    if (current && current === stalePid && !alive(current)) rmSync(lock, { force: true });
    return null;
  } finally {
    rmSync(guard, { force: true });
  }
}

function alive(pid) {
  try {
    process.kill(pid, 0);
    return true;
  } catch (e) {
    return e.code === "EPERM";
  }
}

function runChecks(wt, baseline) {
  // A check with `paths` runs only when the diff touches one of these prefixes.
  for (const check of checkList) {
    const name = check.name ?? check.run;
    const id = `profile:${name}`;
    // The text lists none of them with --no-checks; the JSON still names each as not run.
    if (opts["no-checks"]) {
      add(id, "skip", "--no-checks", [], null);
      continue;
    }
    if (Array.isArray(check.paths) && !changed.some((f) => check.paths.some((p) => f.startsWith(p)))) {
      const d = `skipped (no file under ${check.paths.join(", ")})`;
      add(id, "skip", d, [], `--  ${name}: ${d}`);
      continue;
    }
    const r = spawnSync(check.run, { cwd: wt, shell: true, encoding: "utf8", maxBuffer: 64 * 1024 * 1024 });
    if (r.status === 0) add(id, "ok", "", [], `OK  ${name}`);
    else {
      ok = false;
      const out = `${r.stdout ?? ""}\n${r.stderr ?? ""}`;
      add(id, "fail", `code ${r.status ?? "?"}`, tailLines(out), `FAIL ${name} (code ${r.status ?? "?"}):\n${tail(out)}`);
    }
  }

  // Checks can rewrite tracked files (generated code); `teardown` restores
  // them, so the worktree can still be removed afterwards.
  if (!opts["no-checks"]) {
    for (const cmd of teardownList) spawnSync(cmd, { cwd: wt, shell: true, encoding: "utf8" });
    const left = git(["status", "--porcelain"], wt).out.trimEnd();
    if (left !== baseline) {
      ok = false;
      const d = "the checks left changes (add a `teardown` command to the profile)";
      add("worktree", "fail", d, tailLines(left), `FAIL worktree: ${d}\n${tail(left)}`);
    }
  }
}
// Case-insensitive (the folder resolves on case-insensitive file systems) and
// on a diff without rename detection (a move out of the folder is a deletion
// there). A branch that edits the profile or the rules asks for commands to be run once
// merged: the user reviews that change and approves the new profile again.
const touched = changed.filter((f) => f.toLowerCase().startsWith(".claude/orchestration/"));
const profileHits = touched.map((f) => `${f} profile changed: review and re-approve`);
// Patterns are matched on added lines only, reported as file:line.
const patterns = [...BUILTIN, ...(profile.diffPatterns ?? [])].map((p) => ({ re: new RegExp(p.pattern), why: p.why ?? p.pattern }));
const diff = git(["diff", "--unified=0", "--no-color", `${base}...${branch}`], root).out;
const hits = [...profileHits];
let file = null;
let line = 0;
// `+++` is a file header only before the first hunk; after it, an added line
// whose content starts with `++` looks the same.
let header = false;
for (const l of diff.split("\n")) {
  if (l.startsWith("diff --git ")) header = true;
  else if (header && l.startsWith("+++ ")) file = l.slice(4).replace(/^b\//, "");
  else if (l.startsWith("@@")) {
    header = false;
    line = Number(/\+(\d+)/.exec(l)?.[1] ?? 0);
  } else if (!header && l.startsWith("+")) {
    for (const p of patterns) if (p.re.test(l.slice(1))) hits.push(`${file}:${line} ${p.why} : ${l.slice(1).trim().slice(0, 120)}`);
    line++;
  }
}
if (hits.length) {
  ok = false;
  const shown = hits.slice(0, 40);
  add("patterns", "fail", String(hits.length), shown, `FAIL patterns (${hits.length}):\n${indent(shown)}`);
} else add("patterns", "ok", String(patterns.length), [], `OK  patterns (${patterns.length})`);

finish(true);
