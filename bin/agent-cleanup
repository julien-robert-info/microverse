#!/usr/bin/env node
// Removes an agent's worktree and its merged branch. Refuses while a process
// still runs from the worktree: a forgotten server locks the folder on Windows.
//
// agent-cleanup [--keep-branch] <branch>
//
// --keep-branch frees an interrupted agent's branch: removes the worktree only,
// merged or not, so a new agent can check the branch out. Refuses while the
// worktree holds uncommitted or untracked changes.
"use strict";

const { realpathSync } = require("node:fs");
const { join, resolve, sep } = require("node:path");
const { fail, git, listProcesses, normPath, parseArgs, repoRoot, sanitize, validBranch, worktreeFor } = require("../scripts/orch-lib.js");

// One choke point for everything printed: branch names, paths, process command
// lines and git errors come from the repository or the system.
for (const m of ["log", "error"]) {
  const orig = console[m].bind(console);
  console[m] = (...a) => orig(...a.map((x) => (typeof x === "string" ? sanitize(x) : x)));
}

const opts = parseArgs(process.argv.slice(2), { flags: ["keep-branch"] });
const keepBranch = opts["keep-branch"] === true;
const branch = opts._[0];
if (!branch) fail("usage: agent-cleanup [--keep-branch] <branch>");
if (!validBranch(branch)) fail("REFUSED: invalid branch name, nothing touched");
const root = repoRoot();
const wt = worktreeFor(root, branch);

// Only worktrees under <root>/.claude/worktrees are an agent's. Any other one
// carrying the branch is the user's (their files, maybe ignored ones git would
// not warn about), so nothing is unlocked, removed or deleted for it. Real
// paths, and the separator in the prefix, defeat symlinks and `worktrees-evil`.
if (wt && normPath(wt) !== normPath(root)) {
  const fold = (p) => (process.platform === "win32" ? p.toLowerCase() : p);
  const real = (p) => {
    try {
      return realpathSync.native(p);
    } catch {
      return resolve(p);
    }
  };
  const agentDir = fold(real(join(root, ".claude", "worktrees"))) + sep;
  if (!fold(real(wt)).startsWith(agentDir)) {
    fail(`REFUSED: the worktree of ${branch} is ${wt}, outside ${join(root, ".claude", "worktrees")}: not an agent's, nothing touched`);
  }
}

// Checked first, so an unmerged branch keeps its worktree.
if (git(["rev-parse", "--verify", "--quiet", `refs/heads/${branch}`], root).code !== 0) fail(`branch not found: ${branch}`);
if (!keepBranch && git(["merge-base", "--is-ancestor", branch, "HEAD"], root).code !== 0) fail(`REFUSED: ${branch} is not merged into the current branch`);
if (keepBranch && wt && normPath(wt) !== normPath(root)) {
  const st = git(["status", "--porcelain"], wt);
  if (st.code !== 0) fail(`git status failed in ${wt}: ${st.err.trim()}`);
  if (st.out.trim()) fail(`REFUSED: uncommitted changes in ${wt}; commit or note them first`);
}

if (wt) {
  if (normPath(wt) === normPath(root)) fail(`${branch} is the main checkout's branch: nothing to clean up here`);
  const marker = normPath(wt);
  const all = listProcesses();
  // When the caller ran `cd <worktree> && agent-cleanup`, the shell executing this
  // command carries the worktree path in its own command line: skip ancestors.
  const mine = new Set([process.pid]);
  for (let p = all.find((x) => x.pid === process.pid); p && !mine.has(p.ppid); p = all.find((x) => x.pid === p.ppid)) mine.add(p.ppid);
  const busy = all.filter((p) => !mine.has(p.pid) && normPath(p.line).includes(marker));
  if (busy.length) {
    console.log(`REFUSED: processes still running in ${wt} (${busy.length}):`);
    for (const p of busy) console.log(`    ${p.pid} ${p.line.slice(0, 160)}`);
    console.log("Stop them (or wait for them to finish), then run again.");
    process.exitCode = 1;
    return;
  }
  // Agent worktrees are locked; unlocking one that is not fails harmlessly.
  git(["worktree", "unlock", wt], root);
  const rm = git(["worktree", "remove", wt], root);
  if (rm.code !== 0) fail(`git worktree remove failed: ${rm.err.trim()}`);
  console.log(`OK worktree removed: ${wt}`);
} else console.log("worktree: none for this branch");

if (keepBranch) {
  console.log(`OK branch kept: ${branch}`);
  return;
}
const del = git(["branch", "-d", branch], root);
if (del.code !== 0) fail(`git branch -d failed (unmerged branch?): ${del.err.trim()}`);
console.log(`OK branch deleted: ${branch}`);
